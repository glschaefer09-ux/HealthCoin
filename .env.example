# HealthCoin Environment Variables — copy to .env, never commit .env

# Solana
NEXT_PUBLIC_HEALTHCOIN_MINT=<deploy after mint creation>
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# Reown AppKit
NEXT_PUBLIC_REOWN_PROJECT_ID=<get from cloud.reown.com>

# Database
POSTGRES_DB=healthcoin
POSTGRES_USER=healthcoin
POSTGRES_PASSWORD=

# MariaDB / Drupal (Health Space CMS)
MYSQL_DATABASE=healthspace
MYSQL_USER=healthspace
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Redis
REDIS_PASSWORD=

# Auth
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASS=

# Stripe (provider subscription payments)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Wormhole
NEXT_PUBLIC_WORMHOLE_ENV=testnet

# Anchor program IDs (fill after deploy)
NEXT_PUBLIC_HLTH_STAKING_PROGRAM_ID=
NEXT_PUBLIC_HLTH_ADPOOL_PROGRAM_ID=
NEXT_PUBLIC_HLTH_REWARDS_PROGRAM_ID=
